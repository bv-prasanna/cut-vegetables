# Local secure PostgreSQL API (do NOT commit actual secret values).
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
JWT_SECRET=GENERATE_AT_LEAST_32_CRYPTOGRAPHICALLY_RANDOM_BYTES
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
HOST=127.0.0.1
PORT=3001
# Separate bootstrap CLI only (remove from environment immediately afterward):
BOOTSTRAP_ORG=FreshPrep Veggies
BOOTSTRAP_EMAIL=superadmin@example.com
BOOTSTRAP_PASSWORD=USE_UNIQUE_16_PLUS_CHAR_SECRET

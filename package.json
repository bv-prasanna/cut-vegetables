{
  "name": "freshprep-platform",
  "private": true,
  "packageManager": "npm@10",
  "scripts": {
    "dev": "npm --workspace apps/api run dev",
    "test": "npm --workspace apps/api test",
    "typecheck": "npm --workspace apps/api run typecheck",
    "web:test": "npm run test --workspace @freshprep/web",
    "web:build": "npm run build --workspace @freshprep/web",
    "api:prod": "npm run start:pg --workspace @freshprep/api",
    "check": "npm run typecheck && npm test && npm run web:test && npm run web:build"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ]
}
